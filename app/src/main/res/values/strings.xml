    <string name="help_support_title">Help &amp; Support</string>
    <string name="cd_help_circle_icon">Help Circle Icon</string>
    <string name="getting_started_title">Getting Started</string>
    <string name="getting_started_body">Welcome to Waje\'s Quail Farm System. This app helps you manage your quail farm efficiently by tracking birds, eggs, feed, and tasks.</string>
    <string name="dashboard_title">Dashboard</string>
    <string name="dashboard_body">The dashboard provides a quick overview of your farm. Access shortcuts for inventory, egg counts, water levels, and tasks.</string>
    <string name="tasks_inventory_title">Tasks &amp; Inventory</string>
    <string name="tasks_inventory_body">Use the Schedule tab for daily tasks and the Inventory section to track stock levels (Full, Medium, Low).</string>
    <string name="analytics_reports_title">Analytics &amp; Reports</string>
    <string name="analytics_reports_body">Access detailed reports on your farm performance, egg production trends, feed consumption, and historical data. Use filters to analyze specific time periods.</string>
    <string name="managing_team_members_title">Managing Team Members</string>
    <string name="managing_team_members_body">Send invite codes to team members with specific roles (owner or staff). View pending approval requests and manage team member access through the Privacy &amp; Security settings.</string>
    <string name="settings_preferences_title">Settings &amp; Preferences</string>
    <string name="settings_preferences_body">Customize language preferences, notification settings, account security, and farm configuration. Access Privacy &amp; Security to monitor database status and manage user permissions.</string>
    <string name="tips_best_practices_title">Tips &amp; Best Practices</string>
    <string name="tips_best_practices_body">• Update feed inventory regularly to ensure accurate tracking\n• Review daily tasks to maintain farm efficiency\n• Keep water levels monitored to prevent issues\n• Check analytics weekly to identify trends\n• Maintain clear communication with your team members</string>
    <string name="troubleshooting_title">Troubleshooting</string>
    <string name="troubleshooting_body">• No internet? Ensure your WiFi or mobile data is connected\n• App crashes? Try clearing app cache or reinstalling\n• Sync issues? Check your internet connection and try refreshing\n• Invite code not working? Verify the email matches your registered account\n• Camera not opening? Grant camera permissions in app settings</string>
    <string name="contact_support_title">Contact Support</string>
    <string name="contact_support_body">If you encounter any issues not covered above, please contact our support team at support@wajequailfarm.com. Include details about your farm setup and the issue you\'re experiencing.</string>
</resources>
