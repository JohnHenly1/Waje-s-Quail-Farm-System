    <!-- Privacy & Security dialog strings (extracted from layout) -->
    <string name="system_policies">System Policies</string>
    <string name="data_collection_title">1. Data Collection (The What)</string>
    <string name="data_collection_body">Farm Profile: Name, contact info, and GPS location.\nFlock Records: Quail counts, breeds, age, and mortality rates.\nProduction: Daily egg counts, meat weight, and feed consumption.\nHealth and Biosecurity: Vaccination dates, illness logs, and visitor records.\nFinancials: Feed costs and medicine expenses.</string>
    <string name="privacy_content_title">2. Privacy Content (The How)</string>
    <string name="privacy_content_body">Ownership: The farmer owns all farm-generated data.\nUsage: Data is used only for reports, trend analysis, or vet consultations.\nSharing: We disclose if data goes to 3rd parties such as government disease tracking or researchers.\nAnonymity: Any shared regional data is stripped of the farm name and exact location.</string>
    <string name="security_measures_title">3. Security Measures (The Armor)</string>
    <string name="security_measures_body">Encryption: Data is scrambled during upload and while stored on servers.\nSecure Login: Access is protected by passwords and biometric authentication.\nOffline Safety: Data stored on the device when offline is also protected.\nAccess Control: Only authorized users can see specific farm records.</string>
