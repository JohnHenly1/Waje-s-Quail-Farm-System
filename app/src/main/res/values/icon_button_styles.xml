<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Minimal monochrome icon button: white circle, hairline stroke, charcoal icon -->
    <style name="Widget.App.IconButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:text">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">#212121</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">#FFFFFF</item>
        <item name="strokeColor">#D9DCDA</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#14000000</item>
    </style>

    <!-- Primary action (Capture / Save): solid charcoal, white icon -->
    <style name="Widget.App.IconButton.Primary">
        <item name="backgroundTint">#212121</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

</resources>