<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_message_actions"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select text to copy"
        android:textColor="#355E1A"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:background="#355E1A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Long-press a word, then drag the handles to highlight."
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/selectScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/selectableText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1F2937"
            android:textColorHighlight="#5A9E2F55"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </ScrollView>

    <TextView
        android:id="@+id/selectClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:text="Close"
        android:textColor="#355E1A"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>