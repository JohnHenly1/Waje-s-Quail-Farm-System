<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    tools:context=".EggCountActivity">
    <!--     ══════════════════════  HEADER  ══════════════════════     -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_green"
        android:elevation="0dp"
        android:minHeight="?attr/actionBarSize"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/back"
                android:padding="7dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/egg_count_title"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:alpha="0.85"
                android:gravity="end"
                android:text="@string/live_time_placeholder"
                android:textColor="@color/white"
                android:textSize="11sp" />
            <!--     View already-scanned photos     -->
            <ImageButton
                android:id="@+id/viewScannedBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="View scanned photos"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@android:drawable/ic_menu_gallery"
                app:tint="@color/white" />
            <!--     Reset / refresh counts     -->
            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/reset_counts"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@android:drawable/stat_notify_sync"
                app:tint="@color/white" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <!--     ══════════════════════  SCROLLABLE BODY  ══════════════════════     -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!--     ─────────────  STATUS BANNER (hidden by default)  ─────────────     -->
            <TextView
                android:id="@+id/statusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_dark_green"
                android:backgroundTint="#1B5E20"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Model loaded" />
            <!--     ─────────────  CAMERA CARD  ─────────────     -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#E3E7E4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="300dp">
                        <!--     Live camera preview     -->
                        <androidx.camera.view.PreviewView
                            android:id="@+id/cameraPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <!--     Frozen/picked photo preview     -->
                        <ImageView
                            android:id="@+id/frozenPreviewImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/captured_egg_photo_desc"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                        <!--     Dim overlay when frame is frozen     -->
                        <View
                            android:id="@+id/frozenOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#55000000"
                            android:visibility="gone" />
                        <!--     Bounding-box overlay     -->
                        <com.example.exp1.DetectionOverlayView
                            android:id="@+id/detectionOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                        <!--     Scanning sweep line     -->
                        <View
                            android:id="@+id/scanLineView"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_gravity="top"
                            android:background="#00E676"
                            android:visibility="gone" />
                        <!--     LIVE / ANALYZING / CAPTURED badge (top-left)     -->
                        <TextView
                            android:id="@+id/liveScanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/rounded_dark_green"
                            android:letterSpacing="0.02"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/live_scan_badge"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <!--     Capture mode badge (Single / Batch) — top-right     -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/captureModeToggleBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:backgroundTint="#37474F"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Mode: Single"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />
                        <!--     Detection model badge (YOLOv3 / YOLOv4) — bottom-right     -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modelSwitchBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:backgroundTint="#1B5E20"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Model: YOLOv3 (my_model)"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />
                    </FrameLayout>
                    <!--     Batch thumbnail strip     -->
                    <HorizontalScrollView
                        android:id="@+id/batchThumbnailScroll"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="#1B1B1B"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/batchThumbnailContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!--     ─────────────  CAMERA CONTROL ROW  ─────────────     -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/captureBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/dark_green"
                    android:text="@string/capture_and_analyze"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retakeBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E65100"
                    android:text="@string/retake"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeSwitchBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="#37474F"
                    android:text="@string/pick_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />
            </LinearLayout>
            <!--  Done Button — hidden until a batch is completed  -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/doneBatchBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#00838F"
                android:text="Done — Scan Batch"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:elevation="0dp" />
            <!--     Discard     -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/discardBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#B71C1C"
                android:text="@string/discard"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:elevation="0dp" />
            <!--     Save Collection     -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveCollectionBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#2E7D32"
                android:text="@string/save_collection"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                app:elevation="0dp" />
            <!--    ═══════════════ COUNT + QUALITY ROW ═══════════════    -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">
                <!--     ─── LEFT: Today's Total ───     -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="0.85"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_orange_gradient"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/circle_white"
                            android:backgroundTint="#33FFFFFF">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/lc_egg"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/todayTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textColor="@color/white"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.9"
                            android:gravity="center"
                            android:text="@string/total_eggs_detected"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!--     ─── RIGHT: Quality Distribution ───     -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E3E7E4"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/white"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:letterSpacing="0.02"
                            android:text="@string/grade_distribution"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <!--    Grade A row    -->
                        <LinearLayout
                            android:id="@+id/gradeARow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/bg_grade_row_a"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_a_details"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_white"
                                android:backgroundTint="#2E7D32" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="A"
                                android:textColor="@color/stats_green_end"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeADesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="@string/grade_normal"
                                android:textColor="@color/dark_gray"
                                android:textSize="10sp"
                                android:textStyle="italic" />

                            <TextView
                                android:id="@+id/gradeAValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="#2E7D32"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeAPercent"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="end"
                                android:text="@string/zero_percent"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="4dp"
                            android:background="#EEF0EE" />
                        <!--    Grade B row    -->
                        <LinearLayout
                            android:id="@+id/gradeBRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/bg_grade_row_b"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_b_details"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_white"
                                android:backgroundTint="#F57F17" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="B"
                                android:textColor="@color/orange"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeBDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="@string/grade_cracked"
                                android:textColor="@color/dark_gray"
                                android:textSize="10sp"
                                android:textStyle="italic" />

                            <TextView
                                android:id="@+id/gradeBValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="#F57F17"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeBPercent"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="end"
                                android:text="@string/zero_percent"
                                android:textColor="#F57F17"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="4dp"
                            android:background="#EEF0EE" />
                        <!--    Grade C row    -->
                        <LinearLayout
                            android:id="@+id/gradeCRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_grade_row_c"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_c_details"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_white"
                                android:backgroundTint="#C62828" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="C"
                                android:textColor="@color/red"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeCDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="@string/grade_reject"
                                android:textColor="@color/dark_gray"
                                android:textSize="10sp"
                                android:textStyle="italic" />

                            <TextView
                                android:id="@+id/gradeCValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero"
                                android:textColor="#C62828"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/gradeCPercent"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="end"
                                android:text="@string/zero_percent"
                                android:textColor="#C62828"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!--    ───────────── COLLECTION HISTORY HEADER ─────────────    -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/collection_history"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/calendarBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    app:srcCompat="@android:drawable/ic_menu_my_calendar"
                    app:tint="@color/dark_green" />

                <ImageButton
                    android:id="@+id/prevWeekBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    app:srcCompat="@drawable/ic_arrow_back"
                    app:tint="@color/dark_green" />

                <TextView
                    android:id="@+id/weekRangeTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="@string/this_week"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/nextWeekBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="7dp"
                    app:srcCompat="@drawable/ic_arrow_forward"
                    app:tint="@color/dark_green" />
            </LinearLayout>
            <!--    Collection log rows injected here at runtime    -->
            <LinearLayout
                android:id="@+id/collectionLogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!--    ══════════════════════ BOTTOM NAV ══════════════════════    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/dark_green"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <!--    Home    -->
        <LinearLayout
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/home"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
        <!--    Analytics    -->
        <LinearLayout
            android:id="@+id/analyticsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_chart"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/Report"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
        <!--    Schedule    -->
        <LinearLayout
            android:id="@+id/scheduleButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_schedule"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/schedule"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
        <!--    Profile    -->
        <LinearLayout
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_profile"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/profile"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>