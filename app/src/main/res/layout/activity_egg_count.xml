<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    tools:context=".EggCountActivity">

    <!--     ══════════════════════  HEADER  ══════════════════════     -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_green"
        android:elevation="0dp"
        android:minHeight="?attr/actionBarSize"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/back"
                android:padding="7dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/egg_count_title"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/liveTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:alpha="0.85"
                android:gravity="end"
                android:text="@string/live_time_placeholder"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <!--     View already-scanned photos     -->
            <ImageButton
                android:id="@+id/viewScannedBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="View scanned photos"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@android:drawable/ic_menu_gallery"
                app:tint="@color/white" />

            <!--     Reset / refresh counts     -->
            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_white"
                android:backgroundTint="#26FFFFFF"
                android:contentDescription="@string/reset_counts"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@android:drawable/stat_notify_sync"
                app:tint="@color/white" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!--     ══════════════════════  SCROLLABLE BODY  ══════════════════════     -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!--     ─────────────  STATUS BANNER (hidden by default)  ─────────────     -->
            <TextView
                android:id="@+id/statusBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/rounded_dark_green"
                android:backgroundTint="#1B5E20"
                android:lineSpacingExtra="2dp"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="Model loaded" />

            <!--     ─────────────  CAMERA CARD  ─────────────     -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#E3E7E4"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="300dp">

                        <!--     Live camera preview     -->
                        <androidx.camera.view.PreviewView
                            android:id="@+id/cameraPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!--     Frozen/picked photo preview     -->
                        <ImageView
                            android:id="@+id/frozenPreviewImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/captured_egg_photo_desc"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <!--     Dim overlay when frame is frozen     -->
                        <View
                            android:id="@+id/frozenOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#55000000"
                            android:visibility="gone" />

                        <!--     Bounding-box overlay     -->
                        <com.example.exp1.DetectionOverlayView
                            android:id="@+id/detectionOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!--     Scanning sweep line     -->
                        <View
                            android:id="@+id/scanLineView"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_gravity="top"
                            android:background="#00E676"
                            android:visibility="gone" />

                        <!--     LIVE / ANALYZING / CAPTURED badge (top-left)     -->
                        <TextView
                            android:id="@+id/liveScanLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/rounded_dark_green"
                            android:letterSpacing="0.02"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="@string/live_scan_badge"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!--     Capture mode badge (Single / Batch) — top-right     -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/captureModeToggleBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="10dp"
                            android:backgroundTint="#37474F"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Mode: Single"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />

                        <!--     Detection model badge (YOLOv3 / YOLOv4) — bottom-right     -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/modelSwitchBtn"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:backgroundTint="#1B5E20"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Model: YOLOv3 (my_model)"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp" />
                    </FrameLayout>

                    <!--     Batch thumbnail strip     -->
                    <HorizontalScrollView
                        android:id="@+id/batchThumbnailScroll"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:background="#1B1B1B"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/batchThumbnailContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--     ─────────────  CAMERA CONTROL ROW (icon-only, one aligned row)  ─────────────     -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Discard -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/discardBtn"
                    style="@style/Widget.App.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Discard"
                    android:visibility="gone"
                    app:icon="@drawable/ic_btn_discard" />

                <!-- Retake / Back to camera (icon swapped in code) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retakeBtn"
                    style="@style/Widget.App.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Retake"
                    android:visibility="gone"
                    app:icon="@drawable/ic_btn_retake" />

                <!-- Capture (primary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/captureBtn"
                    style="@style/Widget.App.IconButton.Primary"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Capture"
                    app:icon="@drawable/ic_btn_capture" />

                <!-- Done — scan batch -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/doneBatchBtn"
                    style="@style/Widget.App.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Done, scan batch"
                    android:visibility="gone"
                    app:icon="@drawable/ic_btn_done" />

                <!-- Pick photo / Back to live (icon swapped in code) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modeSwitchBtn"
                    style="@style/Widget.App.IconButton"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Pick photos from gallery"
                    app:icon="@drawable/ic_btn_gallery" />

                <!-- Save collection (primary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveCollectionBtn"
                    style="@style/Widget.App.IconButton.Primary"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Save collection"
                    android:visibility="gone"
                    app:icon="@drawable/ic_btn_save" />
            </LinearLayout>

            <!--    ═══════════════ TOTAL + GRADE DISTRIBUTION (compact) ═══════════════    -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#ECEFEC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!--    Total (label left, number right)    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="@string/total_eggs_detected"
                            android:textAllCaps="true"
                            android:textColor="#8A918B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/todayTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:text="@string/zero"
                            android:textColor="#1A1A1A"
                            android:textSize="30sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp"
                        android:background="#EEF0EE" />

                    <!--    Grades A / B / C in one row    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!--    Grade A    -->
                        <LinearLayout
                            android:id="@+id/gradeARow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_a_details"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="A"
                                    android:textColor="#1A1A1A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/gradeAValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/zero"
                                    android:textColor="#1A1A1A"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/gradeAPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="@string/zero_percent"
                                    android:textColor="#8A918B"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/gradeABar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="#2E7D32"
                                app:trackColor="#F1F3F1"
                                app:trackCornerRadius="2dp"
                                app:trackThickness="4dp" />

                            <TextView
                                android:id="@+id/gradeADesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/grade_normal"
                                android:textColor="@color/black"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!--    Grade B    -->
                        <LinearLayout
                            android:id="@+id/gradeBRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_b_details"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="B"
                                    android:textColor="#1A1A1A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/gradeBValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/zero"
                                    android:textColor="#1A1A1A"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/gradeBPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="@string/zero_percent"
                                    android:textColor="#8A918B"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/gradeBBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="#F57F17"
                                app:trackColor="#F1F3F1"
                                app:trackCornerRadius="2dp"
                                app:trackThickness="4dp" />

                            <TextView
                                android:id="@+id/gradeBDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/grade_cracked"
                                android:textColor="@color/black"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!--    Grade C    -->
                        <LinearLayout
                            android:id="@+id/gradeCRow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:contentDescription="@string/view_grade_c_details"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="C"
                                    android:textColor="#1A1A1A"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/gradeCValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/zero"
                                    android:textColor="#1A1A1A"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/gradeCPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:text="@string/zero_percent"
                                    android:textColor="#8A918B"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/gradeCBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                android:progress="0"
                                app:indicatorColor="#C62828"
                                app:trackColor="#F1F3F1"
                                app:trackCornerRadius="2dp"
                                app:trackThickness="4dp" />

                            <TextView
                                android:id="@+id/gradeCDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/grade_reject"
                                android:textColor="@color/black"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--    ══════════════════════ BOTTOM NAV ══════════════════════    -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1A000000"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/dark_green"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!--    Home    -->
        <LinearLayout
            android:id="@+id/homeButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/home"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!--    Analytics    -->
        <LinearLayout
            android:id="@+id/analyticsButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_chart"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/Report"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!--    Schedule    -->
        <LinearLayout
            android:id="@+id/scheduleButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_schedule"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/schedule"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <!--    Profile    -->
        <LinearLayout
            android:id="@+id/profileButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_profile"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/profile"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>