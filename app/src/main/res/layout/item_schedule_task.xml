<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/schedule_task_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <!--  Header row: category icon, title/category, status pill, delete  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:id="@+id/statusIndicator" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <FrameLayout android:id="@+id/taskIconContainer" android:layout_width="40dp" android:layout_height="40dp">
                <ImageView android:id="@+id/taskIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" app:srcCompat="@drawable/ic_calendar"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/taskTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="Morning Feeding" android:textColor="@color/schedule_task_title" android:textSize="16sp"/>
                <TextView android:id="@+id/taskCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Feeding" android:textColor="@color/schedule_task_subtitle" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/statusPill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:fontFamily="sans-serif-medium" android:text="Pending" android:textSize="12sp"/>
            <androidx.cardview.widget.CardView android:id="@+id/deleteBtnCard" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="8dp" app:cardCornerRadius="8dp" app:cardElevation="0dp" app:cardBackgroundColor="#EF4444">
                <ImageButton android:id="@+id/deleteTaskBtn" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:scaleType="centerInside" android:padding="6dp" app:srcCompat="@drawable/ic_trash" app:tint="@color/white"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <TextView android:id="@+id/taskDeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="52dp" android:layout_marginTop="2dp" android:text="Deadline: 09:00 AM" android:textColor="#E11D48" android:textSize="11sp" android:textStyle="bold" android:visibility="gone"/>
        <!--  Divider  -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:background="#EEEEEE"/>
        <!--  Time + Recurrence row  -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_clock_outline" app:tint="@color/schedule_task_subtitle"/>
            <TextView android:id="@+id/taskTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="sans-serif-medium" android:text="08:00 AM" android:textColor="@color/schedule_task_subtitle" android:textSize="13sp"/>
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="14dp" app:srcCompat="@drawable/ic_repeat" app:tint="@color/schedule_task_subtitle"/>
            <TextView android:id="@+id/taskRecurrence" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Daily" android:textColor="@color/schedule_task_subtitle" android:textSize="13sp"/>
        </LinearLayout>
        <!--  Assigned To row  -->
        <LinearLayout android:id="@+id/assignedToRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_users" app:tint="@color/schedule_task_subtitle"/>
            <TextView android:id="@+id/taskAssignedTo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/bg_chip_neutral" android:text="Jisoo K." android:textColor="@color/schedule_task_title" android:textSize="11sp" android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <!--  Assigned By row (shown to staff so they know who assigned the task)  -->
        <LinearLayout android:id="@+id/assignedByRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" app:srcCompat="@drawable/ic_profile" app:tint="@color/schedule_task_subtitle"/>
            <TextView android:id="@+id/taskAssignedBy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Assigned by: Owner" android:textColor="@color/schedule_task_subtitle" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>