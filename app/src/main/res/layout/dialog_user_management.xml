<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded_top">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="User Management"
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:weightSum="3">

        <TextView
            android:id="@+id/btnRoleLimits"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline_green"
            android:gravity="center"
            android:text="Limits"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnViewCodes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline_green"
            android:gravity="center"
            android:text="Codes"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnInviteNew"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_filled_green"
            android:gravity="center"
            android:text="Add User"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Section label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="12dp"
        android:text="APPROVED MEMBERS"
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <!-- Members list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUserList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#2E7D32"
            android:visibility="gone" />

        <TextView
            android:id="@+id/errorTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Failed to load members."
            android:textColor="#C62828"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Footer: Close button, own white bar, always visible and separated -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/btnCloseUserManagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="end|center_vertical"
        android:padding="20dp"
        android:text="Close"
        android:textColor="#2E7D32"
        android:textStyle="bold"
        android:textSize="15sp" />

</LinearLayout>